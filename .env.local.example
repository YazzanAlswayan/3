# Copy this file to .env.local and fill in your Supabase project values
# Found in Supabase Dashboard -> Project Settings -> API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key is SECRET — server-side only, never exposed to the client.
# Used by API routes to read the puzzle solution and write authoritative results.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
